{
  "title": "ProdOps Runtime \u2014 Delivery & Diligence v3",
  "description": "v3.0.0 | Linha 1: KPIs | Linha 2: Funil + Delivery Journey phases + Diligence Status | Linha 3: Exception Paths. Filtre por $service e $env.",
  "layout_type": "free",
  "tags": [
    "team:prodops"
  ],
  "widgets": [
    {
      "definition": {
        "type": "query_value",
        "title": "Iteration Ativas",
        "precision": 0,
        "autoscale": true,
        "requests": [
          {
            "q": "sum:runtime.event.received{event:prodops.delivery.bootstrap.started,service:$service.value,env:$env.value}.as_count()",
            "aggregator": "sum",
            "conditional_formats": [
              {
                "comparator": ">=",
                "value": 0,
                "palette": "white_on_green"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 3,
        "height": 3
      }
    },
