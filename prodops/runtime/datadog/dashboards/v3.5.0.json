            "definition": {
              "type": "query_value",
              "title": "Lead Time (dias)",
              "title_size": "16",
              "title_align": "left",
              "precision": 1,
              "autoscale": true,
              "requests": [
                {
                  "q": "avg:runtime.delivery.lead_time_days{service:$service.value,env:$env.value}",
                  "aggregator": "avg"
