{
  "title": "ProdOps Runtime — Delivery & Diligence v3",
  "description": "v3.5.0 | Restyled — paleta semântica: blue=in-progress, green=done, red=bloqueio, orange=warning. CI Sync (cool) vs CI Async (warm) no funil. A: KPIs | B: Funil | C: Delivery Journey ×8 | D: Diligence ×4 | E: Exception Paths ×4",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "tags": [
    "team:prodops"
  ],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "A — KPIs",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "Iteration Ativas",
              "title_size": "16",
              "title_align": "left",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "sum:runtime.event.received{event:prodops.delivery.bootstrap.started,service:$service.value,env:$env.value}.as_count()",
                  "aggregator": "sum",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_blue"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "DONE — Concluídas",
              "title_size": "16",
              "title_align": "left",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "sum:runtime.event.received{event:prodops.delivery.promote.completed,service:$service.value,env:$env.value}.as_count()",
                  "aggregator": "sum",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Falhas — Bloqueios",
              "title_size": "16",
              "title_align": "left",
              "precision": 0,
              "autoscale": true,
