          {
            "definition": {
              "type": "query_value",
              "title": "Iteration Ativas",
              "title_size": "16",
              "title_align": "left",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "sum:runtime.event.received{event:prodops.delivery.bootstrap.started,service:$service.value,env:$env.value}.as_count()",
                  "aggregator": "sum",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
