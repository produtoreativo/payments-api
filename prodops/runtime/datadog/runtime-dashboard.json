{
  "title": "RT ProdOps Runtime Dashboard",
  "description": "Observability dashboard for ProdOps delivery phases. Uses iteration:<id> tags from DS-57.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "tags": [
    "team:prodops"
  ],
  "template_variables": [
    {
      "name": "iteration_id",
      "prefix": "iteration",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "service",
      "prefix": "service",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "default": "*"
    }
  ],
  "notify_list": [],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "Cycle Time per Delivery Phase",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "Bootstrap Cycle Time",
              "title_size": "16",
              "title_align": "left",
              "precision": 1,
              "autoscale": true,
              "requests": [
                {
                  "q": "avg:prodops.delivery.cycle_time{iteration:$iteration_id.value,phase:bootstrap,service:$service.value,env:$env.value}",
                  "aggregator": "avg",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "custom_unit": "h"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Hack Cycle Time",
              "title_size": "16",
              "title_align": "left",
              "precision": 1,
              "autoscale": true,
              "requests": [
                {
                  "q": "avg:prodops.delivery.cycle_time{iteration:$iteration_id.value,phase:hack,service:$service.value,env:$env.value}",
                  "aggregator": "avg",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "custom_unit": "h"
            },
            "layout": {
              "x": 3,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Sync Cycle Time",
              "title_size": "16",
              "title_align": "left",
              "precision": 1,
              "autoscale": true,
              "requests": [
                {
                  "q": "avg:prodops.delivery.cycle_time{iteration:$iteration_id.value,phase:sync,service:$service.value,env:$env.value}",
                  "aggregator": "avg",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_green"
